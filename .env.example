# TennisFlow — Variables de entorno
# Copia este archivo como .env y completa los valores

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci...     # service_role key (NO anon)

# ─── Mercado Pago ─────────────────────────────────────────────────────────────
MP_ACCESS_TOKEN=APP_USR-...          # Producción: APP_USR-xxxxx / Test: TEST-xxxxx
MP_WEBHOOK_SECRET=tu_secret_mp       # Firma HMAC del webhook (Panel MP → Webhooks)
MP_CURRENCY_ID=ARS                   # Moneda (ARS, BRL, CLP, etc.)

# ─── Seguridad interna ────────────────────────────────────────────────────────
# Protege los endpoints /api/internal/*
# Soporta múltiples claves separadas por coma para rotación sin downtime:
#   INTERNAL_API_KEY=clave_activa,clave_anterior
INTERNAL_API_KEY=genera_una_clave_aleatoria_segura

# ─── CORS / Frontend ──────────────────────────────────────────────────────────
FRONTEND_URL=https://tu-frontend.vercel.app

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development     # development | production | test
